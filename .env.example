# Copy to .env.local and adjust. Anything prefixed EXPO_PUBLIC_ is bundled into
# the app and readable by anyone: never put secrets here.

# Mock mode: API calls are answered by the fake backend in src/mocks, so
# EXPO_PUBLIC_API_URL below isn't needed. Remove or set to "false" to use the real backend.
# Never enabled in preview or production builds (see eas.json).
EXPO_PUBLIC_USE_MOCK_API=true

# Required when EXPO_PUBLIC_USE_MOCK_API=false.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_APP_ENV=development
# Domain used for HTTPS universal / app links (no protocol).
EXPO_PUBLIC_LINK_DOMAIN=app.example.com

# Android Google Maps SDK key (build-time only, read by app.config.js; never EXPO_PUBLIC_).
# Create one in Google Cloud Console, enable "Maps SDK for Android", and restrict it to the
# package com.beyondcreation.autoconnect + your signing SHA-1. iOS uses Apple Maps (no key).
GOOGLE_MAPS_ANDROID_API_KEY=
