# Copy to .env.local and adjust. Anything prefixed EXPO_PUBLIC_ is bundled into
# the app and readable by anyone: never put secrets here.

# Mock mode: API calls are answered by the fake backend in src/mocks, so
# EXPO_PUBLIC_API_URL below isn't needed. Remove or set to "false" to use the real backend.
# Never enabled in preview or production builds (see eas.json).
EXPO_PUBLIC_USE_MOCK_API=true

# Required when EXPO_PUBLIC_USE_MOCK_API=false.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_APP_ENV=development
# Domain used for HTTPS universal / app links (no protocol).
EXPO_PUBLIC_LINK_DOMAIN=app.example.com

# Map (Android: OpenStreetMap via MapLibre; iOS: Apple Maps, no key). All optional.
# Without them Android uses the public OSM tile server, which is for development only
# (https://operations.osmfoundation.org/policies/tiles/). For production use a provider
# (MapTiler, Stadia, Protomaps) or self-hosted tiles. These values ship inside the app, so use a
# URL-restricted public key only.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.example.com/styles/basic/style.json
# EXPO_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
